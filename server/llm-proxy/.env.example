# Example environment settings for the LLM proxy
# LLM_URL: full URL to your local LLM REST endpoint. If omitted, the proxy will use
# http://localhost:8080/v1/models/<MODEL_NAME>/generate by default.
# Examples:
# LLM_URL=http://localhost:8080/v1/models/gpt4all-mini/generate
LLM_URL=
MODEL_NAME=ggml-model
PORT=5173
