require('dotenv').config();
const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const axios = require('axios');

const app = express();
app.use(cors());
app.use(express.json({ limit: '50mb' }));

const PORT = Number(process.env.PORT || 5174);
const repoRoot = path.resolve(__dirname, '..', '..');
const outputDir = path.join(repoRoot, 'output');
const jobs = new Map();

function makeJobId() {
  return `job_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
}

function ensureOutputDir() {
  fs.mkdirSync(outputDir, { recursive: true });
}

function buildLocalVideoCommand({ prompt, width, height, frames, fps, modelDir, outputPath }) {
  const scriptPath = path.join(repoRoot, 'scripts', 'generate_video.py');
  return {
    command: 'python3',
    args: [
      scriptPath,
      '--model_dir', modelDir || process.env.LOCAL_MODEL_DIR || '',
      '--prompt', prompt,
      '--width', String(width || 768),
      '--height', String(height || 512),
      '--frames', String(frames || 12),
      '--fps', String(fps || 4),
      '--output', outputPath,
      '--seed', String(Date.now() % 100000)
    ]
  };
}

async function callHuggingFace({ prompt, model, max_new_tokens = 256, temperature = 0.7 }) {
  const token = process.env.HF_API_TOKEN;
  const modelName = model || process.env.HF_MODEL || 'google/flan-t5-small';
  if (!token) {
    throw new Error('HF_API_TOKEN is not set. Add it to server/video-proxy/.env to use online mode.');
  }

  const response = await axios.post(
    `https://api-inference.huggingface.co/models/${modelName}`,
    { inputs: prompt, parameters: { max_new_tokens, temperature } },
    {
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      timeout: 120000
    }
  );

  return response.data;
}

async function callReplicate({ prompt, model, width, height, frames, fps }) {
  const token = process.env.REPLICATE_API_TOKEN;
  const modelName = model || process.env.REPLICATE_MODEL || 'black-forest-labs/flux-schnell';
  if (!token) {
    throw new Error('REPLICATE_API_TOKEN is not set. Add it to server/video-proxy/.env to use online mode.');
  }

  const response = await axios.post(
    'https://api.replicate.com/v1/models/' + encodeURIComponent(modelName) + '/predictions',
    {
      input: {
        prompt,
        width: width || 768,
        height: height || 512,
        num_frames: frames || 12,
        fps: fps || 4
      }
    },
    {
      headers: {
        Authorization: `Token ${token}`,
        'Content-Type': 'application/json'
      },
      timeout: 120000
    }
  );

  return response.data;
}

function getProviderAdapter(provider) {
  if (provider === 'hf' || provider === 'huggingface') return callHuggingFace;
  if (provider === 'replicate') return callReplicate;
  return async () => {
    throw new Error(`Unsupported provider: ${provider}. Supported values: hf, replicate.`);
  };
}

app.get('/health', (_req, res) => {
  res.json({ ok: true, mode: 'online-or-offline', timestamp: new Date().toISOString() });
});

app.post('/api/generate/video', async (req, res) => {
  try {
    const {
      prompt,
      mode = process.env.DEFAULT_MODE || 'local',
      provider = process.env.ONLINE_PROVIDER || 'hf',
      modelDir = process.env.LOCAL_MODEL_DIR,
      width = 768,
      height = 512,
      frames = 12,
      fps = 4,
      seed,
      model
    } = req.body || {};

    if (!prompt || !String(prompt).trim()) {
      return res.status(400).json({ error: 'Missing prompt in request body.' });
    }

    const jobId = makeJobId();
    const job = {
      id: jobId,
      status: 'queued',
      mode,
      provider,
      prompt,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      logs: [],
      output: null,
      downloadUrl: null,
      result: null
    };
    jobs.set(jobId, job);

    if (mode === 'offline' || mode === 'local') {
      ensureOutputDir();
      const outputPath = path.join(outputDir, `video_${Date.now()}.mp4`);
      const command = buildLocalVideoCommand({ prompt, width, height, frames, fps, modelDir, outputPath });

      const child = spawn(command.command, command.args, { cwd: repoRoot, stdio: ['ignore', 'pipe', 'pipe'] });

      job.logs.push(`Local generation started: ${command.command} ${command.args.join(' ')}`);
      job.status = 'running';
      job.updatedAt = new Date().toISOString();

      child.stdout.on('data', (chunk) => {
        const text = chunk.toString();
        job.logs.push(text);
        job.updatedAt = new Date().toISOString();
      });

      child.stderr.on('data', (chunk) => {
        const text = chunk.toString();
        job.logs.push(text);
        job.updatedAt = new Date().toISOString();
      });

      child.on('exit', (code) => {
        if (code === 0 && fs.existsSync(outputPath)) {
          job.status = 'completed';
          job.output = outputPath;
          job.downloadUrl = `/api/video/download/${jobId}`;
        } else {
          job.status = 'failed';
          job.error = 'Local generation failed.';
        }
        job.updatedAt = new Date().toISOString();
      });

      return res.status(202).json({
        jobId,
        status: 'queued',
        mode: 'local',
        message: 'Offline video generation started.'
      });
    }

    if (mode === 'online' || mode === 'cloud') {
      job.status = 'running';
      job.updatedAt = new Date().toISOString();

      try {
        const adapter = getProviderAdapter(provider);
        const cloudResult = await adapter({ prompt, model, width, height, frames, fps });
        job.status = 'completed';
        job.result = cloudResult;
        job.output = cloudResult?.output || cloudResult?.url || null;
        job.downloadUrl = job.output || null;
        job.updatedAt = new Date().toISOString();

        return res.status(202).json({
          jobId,
          status: 'completed',
          mode: 'online',
          provider,
          message: 'Online generation flow completed.',
          result: cloudResult
        });
      } catch (err) {
        job.status = 'failed';
        job.error = err?.message || String(err);
        job.updatedAt = new Date().toISOString();
        return res.status(500).json({ error: job.error, jobId });
      }
    }

    return res.status(400).json({ error: `Unsupported mode: ${mode}. Choose local/offline or online/cloud.` });
  } catch (err) {
    return res.status(500).json({ error: err?.message || String(err) });
  }
});

app.get('/api/generate/video/:jobId', (req, res) => {
  const job = jobs.get(req.params.jobId);
  if (!job) return res.status(404).json({ error: 'Job not found.' });
  res.json(job);
});

app.get('/api/video/download/:jobId', (req, res) => {
  const job = jobs.get(req.params.jobId);
  if (!job || !job.output || !fs.existsSync(job.output)) {
    return res.status(404).json({ error: 'Video not available yet or job not found.' });
  }

  res.download(job.output, path.basename(job.output));
});

app.listen(PORT, () => {
  console.log(`Goougas video proxy listening on http://localhost:${PORT}`);
});
